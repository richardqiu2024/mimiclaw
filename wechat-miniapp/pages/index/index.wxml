<view class="page-container">
  <view class="bg-gradient"></view>
  <view class="bg-grid"></view>

  <view class="card page-header">
    <view class="header-main">
      <view class="header-copy">
        <view class="page-title">MimiClaw 指挥台</view>
        <view class="page-desc">蓝牙低功耗设备 CLI 配置与控制中心</view>
      </view>
      <view class="status-inline">
        <view class="status-dot {{isReady ? 'ready' : isConnected ? 'link' : isDiscovering ? 'scan' : 'off'}}"></view>
        <view class="status-copy">
          <view class="status-text">{{state}}</view>
          <view class="status-desc">{{statusText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card hero-card">
    <view class="action-grid">
      <button class="primary action-btn" bindtap="onScan">{{isDiscovering ? "停止扫描" : "扫描终端"}}</button>
      <button class="secondary action-btn" bindtap="onDisconnect" wx:if="{{isConnected}}">断开连接</button>
      <button class="secondary action-btn" bindtap="onReconnect" wx:if="{{!isConnected && lastDeviceId}}">重连上一次</button>
    </view>

    <view class="metric-grid">
      <view class="metric-box">
        <view class="metric-label">网络状态</view>
        <view class="metric-value {{isConnected ? 'text-brand' : ''}}">{{isConnected ? "已连接" : "离线"}}</view>
      </view>
      <view class="metric-box">
        <view class="metric-label">命令队列</view>
        <view class="metric-value">{{commandQueueLength}}</view>
      </view>
      <view class="metric-box metric-box-wide">
        <view class="metric-label">当前设备标识</view>
        <view class="metric-value metric-id">{{lastDeviceId ? lastDeviceId : "未指定"}}</view>
      </view>
    </view>
  </view>

  <view class="card devices-card">
    <view class="card-header">
      <view class="header-title">
        <view class="section-dot"></view>
        <view class="card-title">设备发现网络</view>
      </view>
      <view class="row action-cluster compact">
        <button class="secondary btn-sm" bindtap="onToggleShowAll">
          {{showAllDevices ? "过滤 CLI" : "显示全部"}}
        </button>
        <button class="secondary btn-sm" bindtap="onRequestPermissions">系统权限</button>
      </view>
    </view>

    <view wx:if="{{devices.length === 0}}" class="empty-state">
      <text class="empty-text">未能检测到可用蓝牙终端。</text>
    </view>
    <view class="device-list" wx:else>
      <view wx:for="{{devices}}" wx:key="deviceId" class="device-item">
        <view class="device-info">
          <view class="device-name">{{item.name || "未命名节点"}}</view>
          <view class="device-id">{{item.deviceId}}</view>
        </view>
        <view class="device-actions">
          <view class="device-rssi">RSSI {{item.RSSI}} dBm</view>
          <button class="secondary btn-sm connect-btn" bindtap="onConnect" data-deviceid="{{item.deviceId}}">接入</button>
        </view>
      </view>
    </view>
  </view>

  <view class="card config-card">
    <view class="card-header">
      <view class="header-title">
        <view class="section-dot"></view>
        <view class="card-title">系统层级配置</view>
      </view>
    </view>

    <view class="config-section">
      <view class="section-label-row">
        <view class="section-dot small"></view>
        <view class="form-label">核心网络参数</view>
      </view>
      <view class="form-row">
        <input class="input" placeholder="WLAN SSID" value="{{wifiSsid}}" data-field="wifiSsid" bindinput="onConfigInput" />
        <input class="input" placeholder="Security Key" password="true" value="{{wifiPassword}}" data-field="wifiPassword" bindinput="onConfigInput" />
        <button class="secondary btn-sm" bindtap="onSetWifi" disabled="{{!isReady}}">应用</button>
      </view>

      <view class="form-row static-ip-row">
        <input class="input" placeholder="Static IP (如 192.168.1.88)" value="{{wifiStaticIp}}" data-field="wifiStaticIp" bindinput="onConfigInput" />
        <input class="input" placeholder="Subnet Mask" value="{{wifiStaticMask}}" data-field="wifiStaticMask" bindinput="onConfigInput" />
        <input class="input" placeholder="Gateway" value="{{wifiStaticGateway}}" data-field="wifiStaticGateway" bindinput="onConfigInput" />
        <input class="input" placeholder="DNS Primary" value="{{wifiStaticDns1}}" data-field="wifiStaticDns1" bindinput="onConfigInput" />
        <input class="input" placeholder="DNS Secondary" value="{{wifiStaticDns2}}" data-field="wifiStaticDns2" bindinput="onConfigInput" />
        <button class="secondary btn-sm" bindtap="onSetWifiStatic" disabled="{{!isReady}}">静态化</button>
        <button class="secondary btn-sm warn" bindtap="onClearWifiStatic" disabled="{{!isReady}}">释放</button>
      </view>
    </view>

    <view class="config-section">
      <view class="section-label-row">
        <view class="section-dot small"></view>
        <view class="form-label">推理与 API 密钥</view>
      </view>
      <view class="form-row">
        <input class="input" placeholder="OpenAI / Base API Key" value="{{apiKey}}" data-field="apiKey" bindinput="onConfigInput" />
        <button class="secondary btn-sm" bindtap="onSetApiKey" disabled="{{!isReady}}">部署</button>
      </view>
      <view class="form-row">
        <input class="input" placeholder="Telegram Webhook Token" value="{{tgToken}}" data-field="tgToken" bindinput="onConfigInput" />
        <button class="secondary btn-sm" bindtap="onSetTgToken" disabled="{{!isReady}}">部署</button>
      </view>
      <view class="form-row">
        <input class="input" placeholder="Instance Name (e.g. gpt-4o-mini)" value="{{model}}" data-field="model" bindinput="onConfigInput" />
        <button class="secondary btn-sm" bindtap="onSetModel" disabled="{{!isReady}}">部署</button>
      </view>

      <view class="form-row provider-row">
        <picker mode="selector" range="{{configProviderOptions}}" value="{{configProviderIndex}}" bindchange="onProviderChange">
          <view class="picker-value">{{configProviderOptions[configProviderIndex]}}</view>
        </picker>
        <button class="secondary btn-sm" bindtap="onSetProvider" disabled="{{!isReady}}">指定</button>
      </view>
    </view>

    <view class="row action-cluster bottom-actions">
      <button class="secondary" bindtap="onConfigShow" disabled="{{!isReady}}">审查配置</button>
      <button class="secondary warn" bindtap="onConfigReset" disabled="{{!isReady}}">恢复出厂</button>
      <button class="secondary" bindtap="onRestart" disabled="{{!isReady}}">热重启</button>
    </view>
  </view>

  <view class="card terminal-card">
    <view class="card-header terminal-header">
      <view class="header-title">
        <view class="section-dot"></view>
        <view class="card-title">Console I/O Stream</view>
      </view>
      <view class="queue-label">{{commandQueueLength}} in buffer</view>
    </view>

    <scroll-view class="terminal" scroll-y="true" scroll-into-view="{{logBottomId}}">
      <view wx:for="{{logs}}" wx:key="index" class="terminal-line">{{item}}</view>
      <view wx:if="{{partialLine}}" class="terminal-line partial-line">{{partialLine}}</view>
      <view id="{{logBottomId}}"></view>
    </scroll-view>

    <view class="form-row command-row">
      <input class="input cmd-input" placeholder="Input execution command..." value="{{inputCommand}}" bindinput="onInput" />
      <button class="primary" bindtap="onSend" disabled="{{!isReady}}">提交</button>
    </view>

    <view class="row quick-cmds">
      <button class="secondary btn-sm" bindtap="onQuickCommand" data-cmd="help" disabled="{{!isReady}}">help</button>
      <button class="secondary btn-sm" bindtap="onQuickCommand" data-cmd="wifi_status" disabled="{{!isReady}}">netstat</button>
      <button class="secondary btn-sm" bindtap="onQuickCommand" data-cmd="config_show" disabled="{{!isReady}}">dump_cfg</button>
      <button class="secondary btn-sm clear-btn" bindtap="onClearLogs">clear</button>
    </view>
  </view>
</view>
