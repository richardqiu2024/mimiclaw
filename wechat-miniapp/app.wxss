page {
  --bg-light: #f7fcff;
  --bg-mid: #eef7ff;
  --surface: rgba(255, 255, 255, 0.8);
  --surface-strong: rgba(255, 255, 255, 0.92);
  --line: rgba(14, 116, 144, 0.2);
  --line-strong: rgba(2, 132, 199, 0.36);
  --ink: #0b1630;
  --ink-subtle: #48607c;
  --brand: #008cff;
  --brand-alt: #00b8a9;
  --danger: #cf3a45;
  --shadow: 0 18rpx 52rpx rgba(10, 62, 111, 0.14);

  background:
    radial-gradient(circle at 12% -4%, rgba(0, 181, 255, 0.2), transparent 42%),
    radial-gradient(circle at 95% 8%, rgba(0, 184, 169, 0.15), transparent 34%),
    linear-gradient(165deg, var(--bg-light) 0%, var(--bg-mid) 62%, #f8fcff 100%);
  color: var(--ink);
  font-family: "DIN Alternate", "Avenir Next", "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: none;
}

.card {
  position: relative;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: var(--shadow);
  backdrop-filter: blur(10rpx);
}

.card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(0, 140, 255, 0.9), rgba(0, 184, 169, 0.8));
}

.title {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.subtle {
  color: var(--ink-subtle);
  font-size: 24rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.primary {
  background: linear-gradient(120deg, var(--brand), #3aa7ff);
  color: #ffffff;
  border: 0;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-weight: 700;
  font-size: 26rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 140, 255, 0.24);
}

.secondary {
  background: var(--surface-strong);
  color: var(--ink);
  border: 1rpx solid var(--line-strong);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.primary[disabled],
.secondary[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.input {
  flex: 1;
  min-width: 240rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 14rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--ink);
  font-size: 25rpx;
}

.terminal {
  background:
    linear-gradient(180deg, rgba(7, 20, 38, 0.98), rgba(4, 12, 26, 0.98)),
    repeating-linear-gradient(0deg, rgba(56, 189, 248, 0.06) 0 2rpx, transparent 2rpx 8rpx);
  color: #d7e8ff;
  border: 1rpx solid rgba(125, 211, 252, 0.24);
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 300rpx;
  max-height: 540rpx;
  box-shadow: inset 0 0 0 1rpx rgba(56, 189, 248, 0.12);
  font-family: "JetBrains Mono", "SFMono-Regular", Menlo, Consolas, "Courier New", monospace;
  font-size: 23rpx;
}

.terminal-line {
  white-space: pre-wrap;
  line-height: 1.62;
}
