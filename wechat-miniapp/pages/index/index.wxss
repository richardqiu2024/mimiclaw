.page-container {
  position: relative;
  min-height: 100%;
  padding: 22rpx 20rpx 34rpx;
  box-sizing: border-box;
}

.bg-gradient,
.bg-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.bg-gradient {
  background:
    radial-gradient(circle at 16% 12%, rgba(0, 229, 255, 0.08), transparent 42%),
    radial-gradient(circle at 84% 24%, rgba(59, 130, 246, 0.09), transparent 36%);
}

.bg-grid {
  background-image:
    linear-gradient(to right, rgba(255, 255, 255, 0.02) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
  opacity: 0.2;
}

.page-header,
.hero-card,
.devices-card,
.config-card,
.terminal-card {
  position: relative;
  z-index: 1;
  margin-bottom: 18rpx;
  animation: panel-rise 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.devices-card {
  animation-delay: 60ms;
}

.config-card {
  animation-delay: 100ms;
}

.terminal-card {
  animation-delay: 140ms;
}

.header-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
}

.header-copy {
  flex: 1;
  min-width: 320rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.8rpx;
}

.page-desc {
  margin-top: 8rpx;
  color: var(--ink-subtle);
  font-size: 24rpx;
  line-height: 1.55;
}

.status-inline {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #71717a;
}

.status-dot.ready {
  background: #34d399;
  box-shadow: 0 0 0 6rpx rgba(52, 211, 153, 0.18);
}

.status-dot.link {
  background: #67e8f9;
  box-shadow: 0 0 0 6rpx rgba(103, 232, 249, 0.16);
}

.status-dot.scan {
  background: #38bdf8;
  box-shadow: 0 0 0 6rpx rgba(56, 189, 248, 0.16);
  animation: status-pulse 1.9s ease-in-out infinite;
}

.status-dot.off {
  background: #71717a;
}

.status-copy {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.status-text {
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
}

.status-desc {
  color: var(--ink-subtle);
  font-size: 20rpx;
  line-height: 1.4;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.action-btn {
  flex: 1 1 220rpx;
}

.metric-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.metric-box {
  flex: 1 1 200rpx;
  min-height: 104rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.02);
}

.metric-box-wide {
  flex-basis: 100%;
}

.metric-label {
  color: var(--ink-subtle);
  font-size: 20rpx;
  letter-spacing: 0.4rpx;
}

.metric-value {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.metric-id {
  word-break: break-all;
  font-size: 22rpx;
}

.card-header {
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  flex-wrap: wrap;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 40rpx;
}

.section-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--brand);
  box-shadow: 0 0 0 6rpx var(--brand-soft);
}

.section-dot.small {
  width: 8rpx;
  height: 8rpx;
  box-shadow: 0 0 0 4rpx rgba(0, 229, 255, 0.12);
}

.card-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.action-cluster.compact {
  margin-top: 0;
}

.btn-sm {
  min-height: 62rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.empty-state {
  margin-top: 8rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.02);
}

.empty-text {
  color: var(--ink-subtle);
  font-size: 23rpx;
  line-height: 1.6;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-name {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
}

.device-id {
  margin-top: 6rpx;
  color: var(--ink-subtle);
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-all;
}

.device-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.device-rssi {
  color: #7dd3fc;
  font-size: 22rpx;
  font-family: "JetBrains Mono", "SFMono-Regular", Menlo, Consolas, monospace;
}

.connect-btn {
  min-width: 122rpx;
}

.config-section + .config-section {
  margin-top: 20rpx;
}

.section-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-label {
  color: #e4e4e7;
  font-size: 24rpx;
  font-weight: 600;
}

.form-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.form-row .input {
  flex: 1 1 240rpx;
}

.form-row .btn-sm {
  flex-shrink: 0;
}

.static-ip-row .input {
  flex: 1 1 210rpx;
  min-width: 190rpx;
}

.provider-row picker {
  flex: 1;
  min-width: 220rpx;
}

.picker-value {
  min-height: 74rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  border-radius: 14rpx;
  border: 1rpx solid var(--border-soft);
  background: var(--panel-input);
  color: var(--ink);
  font-size: 24rpx;
}

.secondary.warn {
  background: var(--danger-soft);
  border-color: rgba(248, 113, 113, 0.44);
  color: #fecaca;
}

.secondary.warn:active {
  background: rgba(248, 113, 113, 0.26);
}

.bottom-actions {
  margin-top: 18rpx;
  gap: 10rpx;
}

.bottom-actions .secondary {
  flex: 1 1 170rpx;
}

.terminal-header {
  margin-bottom: 10rpx;
}

.queue-label {
  min-height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--ink-subtle);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.02);
}

.terminal {
  background:
    linear-gradient(180deg, #010203 0%, #000000 100%),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.02) 0 2rpx, transparent 2rpx 8rpx);
  border-color: rgba(255, 255, 255, 0.08);
}

.partial-line {
  color: #67e8f9;
}

.command-row {
  margin-top: 12rpx;
  align-items: stretch;
}

.cmd-input {
  min-width: 280rpx;
}

.command-row .primary {
  min-width: 140rpx;
}

.quick-cmds {
  margin-top: 12rpx;
  gap: 10rpx;
}

.quick-cmds .btn-sm {
  min-width: 126rpx;
}

.clear-btn {
  border-color: rgba(255, 255, 255, 0.2);
  color: #e4e4e7;
}

@media (max-width: 680rpx) {
  .page-container {
    padding-left: 16rpx;
    padding-right: 16rpx;
  }

  .header-main {
    flex-direction: column;
  }

  .header-copy {
    min-width: 0;
    width: 100%;
  }

  .status-inline {
    width: 100%;
    justify-content: flex-start;
  }

  .action-btn {
    flex-basis: 100%;
  }

  .form-row .input,
  .static-ip-row .input,
  .provider-row picker {
    flex-basis: 100%;
    min-width: 0;
  }

  .device-item {
    flex-direction: column;
  }

  .device-actions {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .connect-btn {
    min-width: 140rpx;
  }
}

@keyframes panel-rise {
  from {
    transform: translateY(12rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes status-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 6rpx rgba(56, 189, 248, 0.16);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(56, 189, 248, 0);
  }
}
