page {
  --bg-0: #000000;
  --bg-1: #06090e;
  --bg-2: #0b1018;
  --panel: rgba(255, 255, 255, 0.03);
  --panel-strong: rgba(255, 255, 255, 0.05);
  --panel-input: rgba(255, 255, 255, 0.04);
  --border: rgba(255, 255, 255, 0.08);
  --border-soft: rgba(255, 255, 255, 0.06);
  --ink: #fafafa;
  --ink-subtle: #a1a1aa;
  --brand: #00e5ff;
  --brand-alt: #3b82f6;
  --brand-soft: rgba(0, 229, 255, 0.16);
  --danger: #f87171;
  --danger-soft: rgba(248, 113, 113, 0.18);
  --shadow-soft: 0 12rpx 30rpx rgba(0, 0, 0, 0.26);

  min-height: 100%;
  background:
    radial-gradient(circle at 8% -14%, rgba(0, 229, 255, 0.12), transparent 42%),
    radial-gradient(circle at 92% -20%, rgba(59, 130, 246, 0.12), transparent 38%),
    linear-gradient(165deg, var(--bg-0) 0%, var(--bg-1) 54%, var(--bg-2) 100%);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  line-height: 1.2;
}

button::after {
  border: none;
}

.card {
  position: relative;
  overflow: hidden;
  background: var(--panel);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(24rpx) saturate(130%);
  -webkit-backdrop-filter: blur(24rpx) saturate(130%);
}

.title {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  line-height: 1.2;
}

.subtle {
  color: var(--ink-subtle);
  font-size: 24rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 74rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(125, 227, 255, 0.46);
  border-radius: 14rpx;
  background: linear-gradient(122deg, var(--brand) 0%, var(--brand-alt) 100%);
  color: #f6fcff;
  font-weight: 700;
  font-size: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 184, 255, 0.24);
}

.primary:active {
  filter: brightness(0.94);
}

.secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 74rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.02);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.secondary:active {
  background: var(--panel-strong);
  border-color: rgba(255, 255, 255, 0.16);
}

.primary[disabled],
.secondary[disabled] {
  opacity: 0.42;
  box-shadow: none;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.input {
  flex: 1;
  min-width: 220rpx;
  min-height: 74rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-soft);
  border-radius: 14rpx;
  padding: 0 18rpx;
  background: var(--panel-input);
  color: var(--ink);
  font-size: 24rpx;
}

.input:focus {
  border-color: rgba(0, 229, 255, 0.56);
  box-shadow: 0 0 0 1rpx rgba(0, 229, 255, 0.24);
  background: rgba(255, 255, 255, 0.06);
}

.terminal {
  background: #010204;
  color: #e4e4e7;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 300rpx;
  max-height: 560rpx;
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.03),
    inset 0 -20rpx 36rpx rgba(0, 0, 0, 0.56);
  font-family: "JetBrains Mono", "SFMono-Regular", Menlo, Consolas, "Courier New", monospace;
  font-size: 23rpx;
}

.terminal-line {
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.62;
}

.text-brand {
  color: #67e8f9;
}
